# Copy to .env and adjust. .env is gitignored; this file is not.
#
# These are development-only credentials for the MinIO container that ships with
# the dev stack. They are not secret and are not used anywhere else — production
# supplies its own from the deployment's secret store (CARA-77).
MINIO_ROOT_USER=caraadmin
MINIO_ROOT_PASSWORD=caraadmin123

# Host port overrides. Compose falls back to the conventional ports when these
# are absent, so only set them when something already holds 5432 or 9000.
# POSTGRES_PORT=5434
# MINIO_PORT=9100
# MINIO_CONSOLE_PORT=9101
