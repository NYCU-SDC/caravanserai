# cara-agent settings, read by cara-agent.service.
#
#   1. Set SERVER_URL below, and NODE_NAME if this Node's name is not its hostname.
#   2. On a machine with caractl and an administrator token:
#        caractl node token create <node name>
#      Put the printed join token in /etc/cara/join-token (mode 0600). It is
#      valid once, for one hour by default.
#   3. sudo systemctl enable --now cara-agent
#
# On its first start the agent trades the join token for its own Node token and
# keeps that under /var/lib/cara/identity; the join token is not needed again.
# Every setting is listed under "Configuration" in the project README.

# The cara-server address. Required.
#SERVER_URL=http://cara-server.example:8080

# This Node's name in cara. Defaults to the hostname.
#NODE_NAME=

JOIN_TOKEN_FILE=/etc/cara/join-token

# The address cara-server reaches this agent at. Required unless the Node joins
# a Headscale overlay (HEADSCALE_URL and HEADSCALE_PREAUTH_KEY_FILE).
#AGENT_ADVERTISE_IP=

# Managed volume backups need an object store:
#S3_ENDPOINT=https://s3.example:9000
#S3_BUCKET=
#S3_ACCESS_KEY=
#S3_SECRET_KEY=
#S3_CA_FILE=
