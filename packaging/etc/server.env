# cara-server settings, read by cara-server.service. Set DATABASE_URL, then
#   sudo systemctl enable --now cara-server
# Every setting is listed under "Configuration" in the project README.

# The PostgreSQL 16 database the control plane keeps its state in. Required.
#DATABASE_URL=postgresql://cara:PASSWORD@127.0.0.1:5432/caravanserai?sslmode=disable

HOST=0.0.0.0
PORT=8080

# The administrator token, generated when the package was first installed.
# caractl takes it as CARA_TOKEN:
#   export CARA_TOKEN="$(sudo cat /etc/cara/break-glass-token)"
BREAK_GLASS_TOKEN_FILE=/etc/cara/break-glass-token
